#!/usr/bin/env python3
"""Extract Grok Build session transcripts into wiki-ready markdown.

Sibling of wiki-harvest-conversations (Claude Code). Reads ~/.grok/sessions/
and emits one markdown file per project into $WIKI_DIR/raw/conversations/.

Usage: wiki-harvest-grok                    # harvest all projects
       wiki-harvest-grok --project sw       # filter by slug substring
       wiki-harvest-grok --since 2026-08-01 # only sessions updated since
       wiki-harvest-grok --list             # list projects only
       wiki-harvest-grok --dry-run          # print to stdout

Size discipline: only summary.json and chat_history.jsonl are ever opened.
updates.jsonl (10 MB+), events.jsonl, terminal/, recap_requests/ and
subagents/ are never read -- they are excluded by name, not by inspection.
"""

import argparse
import datetime as dt
import json
import os
import re
import sys
import urllib.parse

# --- tunables -------------------------------------------------------------
# Per-message truncation. Matches the Claude sibling. This single number is
# what keeps output KB-scale: without it the corpus is ~16 MB of prose.
TRUNCATE_CHARS = 2000

# Plain `subagent` sessions get a full transcript only at or above this many
# chat messages (the observed median for that kind); the rest are listed
# header-only. `subagent_resume` sessions are always harvested in full --
# a resume means the session was re-entered, which tracks real design work.
SUBAGENT_FULL_MIN_MESSAGES = 80

# Sessions this small are header-only regardless of kind.
TRIVIAL_MAX_MESSAGES = 4

# The only filenames this tool is ever allowed to open.
READABLE_FILES = ("summary.json", "chat_history.jsonl")

# Environment/harness preamble wrappers seen in user messages. Real prompts
# arrive inside <user_query>; these are stripped when no <user_query> exists.
PREAMBLE_TAGS = (
    "user_info",
    "git_status",
    "user_rule",
    "rules",
    "system-reminder",
    "skill_information",
    "skills_referenced",
    "attached_files",
)

GROK_SESSIONS = os.path.join(os.environ.get("GROK_HOME", os.path.expanduser("~/.grok")), "sessions")
WIKI_DIR = os.environ.get("WIKI_DIR", os.path.expanduser("~/wiki"))


# --- project naming -------------------------------------------------------
def decode_project(name):
    """%2FUsers%2Fjoe.smith%2Fsrc%2Fsw -> /Users/joe.smith/src/sw"""
    return urllib.parse.unquote(name)


def project_slug(name):
    """Mirror the Claude sibling's slug rules: strip $HOME, flatten / and .,
    drop a leading src-, and abbreviate workspace-github-com- to gh-."""
    path = decode_project(name)
    home = os.path.expanduser("~")
    if path.startswith(home):
        path = path[len(home) :]
    path = path.strip("/")
    if not path:
        return "home"
    slug = path.replace("/", "-").replace(".", "-")
    if slug.startswith("src-"):
        slug = slug[len("src-") :]
    if slug.startswith("workspace-github-com-"):
        slug = "gh-" + slug[len("workspace-github-com-") :]
    return slug


# --- session metadata -----------------------------------------------------
def open_session_file(session_dir, filename):
    """Single choke point for reading anything inside a session dir.

    Enforces READABLE_FILES so a future edit cannot accidentally start
    reading updates.jsonl (10 MB+), events.jsonl or terminal/ captures.
    """
    if filename not in READABLE_FILES:
        raise AssertionError(f"refusing to open {filename}: not in READABLE_FILES")
    return open(os.path.join(session_dir, filename))


def read_summary(session_dir):
    """Return the parsed summary.json, or None if absent/unreadable.

    The session tree is live -- Grok may be writing while we read -- so every
    failure here is a skip, never a crash.
    """
    try:
        with open_session_file(session_dir, "summary.json") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def session_when(summary):
    """Best available timestamp, as a date string, plus the raw value."""
    for key in ("updated_at", "last_active_at", "created_at"):
        raw = summary.get(key)
        if raw:
            return raw[:10], raw
    return "?", None


def session_kind(summary):
    return summary.get("session_kind") or "interactive"


def wants_full_transcript(summary):
    """The fast pass: decided from summary.json alone, so a session that
    fails it never has its chat_history.jsonl opened."""
    msgs = summary.get("num_chat_messages") or 0
    if msgs <= TRIVIAL_MAX_MESSAGES:
        return False
    kind = session_kind(summary)
    if kind == "subagent":
        return msgs >= SUBAGENT_FULL_MIN_MESSAGES
    # interactive, fork, subagent_resume, and any future kind: always full.
    return True


# --- transcript extraction ------------------------------------------------
def block_text(content):
    """user content is a list of {"type":"text"} blocks; assistant is a str."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "".join(
            b.get("text", "")
            for b in content
            if isinstance(b, dict) and b.get("type") == "text"
        )
    return ""


def clean_user_text(raw):
    """Keep what Joe actually typed.

    Real prompts are wrapped in <user_query>...</user_query>. When that
    wrapper is present, take only its contents -- which discards the
    <user_info>/<git_status> preamble for free. Otherwise strip the known
    harness wrappers and keep whatever prose is left.
    """
    queries = re.findall(r"<user_query>(.*?)</user_query>", raw, re.S)
    if queries:
        return "\n\n".join(q.strip() for q in queries if q.strip())
    text = raw
    for tag in PREAMBLE_TAGS:
        text = re.sub(rf"<{tag}>.*?</{tag}>", "", text, flags=re.S)
        text = re.sub(rf"<{tag}>.*", "", text, flags=re.S)  # unclosed variant
    return text.strip()


def truncate(text):
    if len(text) <= TRUNCATE_CHARS:
        return text
    return text[:TRUNCATE_CHARS] + f"\n\n... ({len(text)} chars total, truncated)"


def extract_transcript(session_dir):
    """Stream chat_history.jsonl, yielding (role, text) for real turns only."""
    turns = []
    try:
        fh = open_session_file(session_dir, "chat_history.jsonl")
    except OSError:
        return turns
    with fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if not isinstance(entry, dict):
                continue
            kind = entry.get("type")
            if kind == "user":
                # synthetic_reason marks harness-injected messages
                # (system reminders, compaction notes, task-completion
                # pings) that Joe never typed.
                if entry.get("synthetic_reason") is not None:
                    continue
                text = clean_user_text(block_text(entry.get("content")))
                role = "USER"
            elif kind == "assistant":
                text = block_text(entry.get("content")).strip()
                role = "ASSISTANT"
            else:
                # system / reasoning / tool_result -> dropped
                continue
            if text:
                turns.append((role, truncate(text)))
    return turns


# --- discovery ------------------------------------------------------------
def list_sessions(project_dir):
    """Session dirs, chronologically (uuidv7 ids sort by time)."""
    try:
        entries = sorted(os.listdir(project_dir))
    except OSError:
        return []
    out = []
    for name in entries:
        full = os.path.join(project_dir, name)
        if not os.path.isdir(full):
            continue
        if name in ("terminal", "recap_requests", "subagents"):
            continue
        out.append(full)
    return out


def list_projects():
    try:
        names = sorted(os.listdir(GROK_SESSIONS))
    except OSError:
        return []
    return [n for n in names if os.path.isdir(os.path.join(GROK_SESSIONS, n))]


def collect(project_dir, since_date):
    """Return (full, headers) session records, applying the fast pass."""
    full, headers = [], []
    for session_dir in list_sessions(project_dir):
        summary = read_summary(session_dir)
        if summary is None:
            continue
        date, raw_ts = session_when(summary)
        if since_date and (raw_ts is None or date < since_date):
            continue
        record = {
            "dir": session_dir,
            "id": os.path.basename(session_dir),
            "summary": summary,
            "date": date,
        }
        if wants_full_transcript(summary):
            full.append(record)
        else:
            headers.append(record)
    return full, headers


# --- rendering ------------------------------------------------------------
def render_header(record, index):
    s = record["summary"]
    title = (s.get("session_summary") or s.get("generated_title") or "untitled").strip()
    title = " ".join(title.split())
    lines = [f"## Session {index} — {title}", ""]
    lines.append(f"- Session: `{record['id']}`")
    lines.append(f"- Kind: {session_kind(s)} · Date: {record['date']}")
    bits = []
    if s.get("current_model_id"):
        bits.append(f"Model: {s['current_model_id']}")
    if s.get("num_chat_messages") is not None:
        bits.append(f"Messages: {s['num_chat_messages']}")
    if s.get("agent_name"):
        bits.append(f"Agent: {s['agent_name']}")
    if bits:
        lines.append("- " + " · ".join(bits))
    git_bits = []
    if s.get("head_branch"):
        git_bits.append(f"Branch: `{s['head_branch']}`")
    if s.get("head_commit"):
        git_bits.append(f"Commit: `{s['head_commit'][:12]}`")
    if git_bits:
        lines.append("- " + " · ".join(git_bits))
    if s.get("last_turn_summary"):
        lines.append(f"- Outcome: {' '.join(str(s['last_turn_summary']).split())}")
    plan = os.path.join(record["dir"], "plan.md")
    if os.path.exists(plan):
        lines.append(f"- Plan: `{plan}`")
    lines.append("")
    return lines


def render_project(slug, project_name, full, headers):
    lines = [f"# Grok Build conversations: {slug}", ""]
    lines.append(f"Project: `{decode_project(project_name)}`")
    lines.append(f"Sessions: {len(full)} full, {len(headers)} header-only")
    lines.append(f"Harvested: {dt.date.today():%Y-%m-%d}")
    lines.append("")

    for i, record in enumerate(full, 1):
        lines.append("---")
        lines.append("")
        lines.extend(render_header(record, i))
        turns = extract_transcript(record["dir"])
        if not turns:
            lines.append("(no readable turns)")
            lines.append("")
            continue
        for role, text in turns:
            lines.append(f"### {role}")
            lines.append("")
            lines.append(text)
            lines.append("")

    if headers:
        lines.append("---")
        lines.append("")
        lines.append("## Sessions not fully harvested")
        lines.append("")
        lines.append(
            f"Below the fast-pass bar (plain subagent runs under "
            f"{SUBAGENT_FULL_MIN_MESSAGES} messages, or any session under "
            f"{TRIVIAL_MAX_MESSAGES + 1}). Listed so nothing is invisible; "
            f"transcripts were never opened."
        )
        lines.append("")
        lines.append("| Date | Kind | Msgs | Title | Session |")
        lines.append("|---|---|---|---|---|")
        for record in headers:
            s = record["summary"]
            title = (s.get("session_summary") or s.get("generated_title") or "untitled").strip()
            title = " ".join(title.split()).replace("|", "\\|")[:80]
            lines.append(
                "| %s | %s | %s | %s | `%s` |"
                % (
                    record["date"],
                    session_kind(s),
                    s.get("num_chat_messages", "?"),
                    title,
                    record["id"],
                )
            )
        lines.append("")

    return "\n".join(lines) + "\n"


# --- main -----------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--list", dest="list_only", action="store_true")
    parser.add_argument("--project", default="")
    parser.add_argument("--since", default="")
    args = parser.parse_args()

    if not os.path.isdir(GROK_SESSIONS):
        sys.exit(f"No Grok sessions found at {GROK_SESSIONS}")

    since_date = ""
    if args.since:
        try:
            since_date = dt.datetime.strptime(args.since, "%Y-%m-%d").strftime("%Y-%m-%d")
        except ValueError:
            sys.exit(f"--since expects YYYY-MM-DD, got: {args.since}")

    projects = list_projects()

    if args.list_only:
        print("Grok Build Projects:")
        print("")
        for name in projects:
            slug = project_slug(name)
            if args.project and args.project.lower() not in slug.lower():
                continue
            full, headers = collect(os.path.join(GROK_SESSIONS, name), since_date)
            latest = max((r["date"] for r in full + headers), default="-")
            print(
                "  %-52s %3d full  %3d header  (latest: %s)"
                % (slug, len(full), len(headers), latest)
            )
        return

    out_dir = os.path.join(WIKI_DIR, "raw", "conversations")
    if not args.dry_run:
        os.makedirs(out_dir, exist_ok=True)

    processed = written_bytes = 0
    for name in projects:
        slug = project_slug(name)
        if args.project and args.project.lower() not in slug.lower():
            continue
        full, headers = collect(os.path.join(GROK_SESSIONS, name), since_date)
        if not full and not headers:
            continue
        print(
            "Processing: %s (%d full, %d header-only)..." % (slug, len(full), len(headers)),
            file=sys.stderr,
        )
        text = render_project(slug, name, full, headers)
        if args.dry_run:
            sys.stdout.write(text)
        else:
            path = os.path.join(out_dir, f"grokbuild-{slug}.md")
            with open(path, "w") as fh:
                fh.write(text)
            written_bytes += len(text.encode())
        processed += 1

    if not args.dry_run:
        print("")
        print("Harvested %d projects (%.1f MB) to: %s/" % (processed, written_bytes / 1e6, out_dir))
        print("")
        print("Next steps:")
        print("  cd ~/wiki && claude")
        print('  Then ask: "Ingest the conversations in raw/conversations/ — summarize key')
        print('  decisions, architecture patterns, and knowledge per project."')


if __name__ == "__main__":
    main()
